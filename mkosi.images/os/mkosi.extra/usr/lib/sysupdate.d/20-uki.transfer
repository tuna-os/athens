[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://%W.updates.elementaryos.org/%a
MatchPattern=athens_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=athens_@v_%a+@l-@d.efi \
             athens_@v_%a+@l.efi \
             athens_@v_%a.efi \
             athens_@v+@l-@d.efi \
             athens_@v+@l.efi \
             athens_@v.efi
# MatchPartitionType=uki
Mode=0600
TriesLeft=3
TriesDone=0
InstancesMax=2
